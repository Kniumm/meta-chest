{
	"schemaVersion": 1,
	"id": "meta-chest",
	"version": "${version}",
	"name": "Meta Chest",
	"description": "Adds 2 new chests: a common chest for common items, and another whose contents can be shared with other chests.",
	"authors": [
		"Kniumm"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/meta-chest",
		"sources": "https://github.com/Kniumm/meta-chest"
	},
	"license": "MIT",
	"icon": "assets/metachest/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"kniumm.metachest.MetaChest"
		],
		"client": [
			"kniumm.metachest.client.MetaChestClient"
		],
		"fabric-datagen": [
			"kniumm.metachest.client.datagen.MetaChestDataGenerator"
		]
	},
	"mixins": [
		"meta-chest.mixins.json",
		{
			"config": "meta-chest.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"libsalad": ">=1.0.0"
	}
}